# Milvus 2.6 Control Plane — environment template.
#
# Usage:  cp .env.example .env
#
# Every value below is a working local-demo default. There are no placeholders
# to fill in and no real credentials here. `.env` itself is gitignored.

# ---------------------------------------------------------------------------
# Compose project and pinned image versions (never use :latest)
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=milvus-cp
DOCKER_VOLUME_DIRECTORY=./volumes
MILVUS_VERSION=v2.6.20
ETCD_VERSION=v3.5.25
MINIO_VERSION=RELEASE.2024-05-28T17-19-04Z
POSTGRES_VERSION=16-alpine

# ---------------------------------------------------------------------------
# Object store (MinIO) — Milvus segment storage and Woodpecker WAL backend
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=milvus-bucket

# ---------------------------------------------------------------------------
# Control-plane relational store
# ---------------------------------------------------------------------------
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=controlplane
POSTGRES_DB=controlplane
POSTGRES_HOST=cp-postgres
# In-network port that cp-api uses to reach cp-postgres. Keep this at 5432:
# it is the port inside cp-net, not on your machine.
POSTGRES_PORT=5432
# Host publish port, separate from the above so a local port clash cannot
# corrupt the API's connection string. Set this if something already owns 5432
# (a native PostgreSQL install is the usual culprit) — e.g. POSTGRES_HOST_PORT=5433.
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Milvus endpoints
#
# These are container-network names, correct when cp-api runs inside Compose.
# To run the API on the host for debugging, override both to localhost:
#   MILVUS_URI=http://localhost:19530
#   MILVUS_METRICS_URI=http://localhost:9091
# ---------------------------------------------------------------------------
MILVUS_URI=http://milvus-standalone:19530
MILVUS_METRICS_URI=http://milvus-standalone:9091
MILVUS_CONNECT_TIMEOUT_S=3
MILVUS_RPC_TIMEOUT_S=5

# ---------------------------------------------------------------------------
# Control-plane runtime
# ---------------------------------------------------------------------------
DOCKER_SOCKET=/var/run/docker.sock
CP_API_PORT=8000
CP_LOG_LEVEL=INFO
CP_HEALTH_INTERVAL_S=15
CP_SNAPSHOT_INTERVAL_S=60
CP_CACHE_TTL_S=5
CP_BREAKER_FAIL_MAX=3
CP_BREAKER_RESET_S=30
CP_RETENTION_DAYS=7
DASHBOARD_PORT=8080
